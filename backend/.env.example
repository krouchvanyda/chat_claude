# ===========================================================================
# Copy to .env and edit before running `docker compose up` or `./gradlew bootRun`.
# ===========================================================================

# --- Database ---
# Host port 5433 (5432 is used by the ERP's Postgres). Used for local `./gradlew bootRun`.
DB_URL=jdbc:postgresql://localhost:5433/chatapp
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Used by the postgres container in docker-compose.yml
POSTGRES_DB=chatapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port the postgres container is published on (container port stays 5432).
DB_HOST_PORT=5433

# --- Server (REST API) ---
SERVER_PORT=5001
SERVER_CONTEXT_PATH=/

# --- Socket.IO (separate port; netty-socketio can't share Tomcat's port) ---
SOCKETIO_HOST=0.0.0.0
SOCKETIO_PORT=5002

# --- Uploads ---
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=10MB
